# ---- required ----
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sie      # privileged URL (migrations, worker, system services)
APP_DATABASE_URL=postgres://sie_app:CHANGE_ME@127.0.0.1:5432/sie  # non-superuser role (npm run db:roles) so RLS is enforced
SIE_ENCRYPTION_KEY=                                               # 64 hex chars; encrypts provider/integration secrets
PORT=8080
SIE_STORAGE_DIR=./var/storage                                     # persistent volume for git repositories (and assets unless S3 is set)
SIE_S3_BUCKET=                                                    # optional S3-compatible asset storage
SIE_S3_REGION=
SIE_S3_ENDPOINT=                                                  # e.g. https://<account>.r2.cloudflarestorage.com

# ---- AI providers (any subset; server-side only, never sent to browsers) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=                                       # e.g. https://openrouter.ai/api/v1
# Spending: the operator-wide cap starts at $0. Raise it explicitly:  npm run admin -- set-global-cap 25
# and fund tenants:  npm run admin -- fund-tenant <tenantId> 10

# ---- identity ----
SIE_DEV_AUTH=0                         # 1 enables /v1/dev/login (refused when NODE_ENV=production)
OIDC_ISSUER=
OIDC_ACADEMY_CLIENT_ID=
OIDC_ACADEMY_CLIENT_SECRET=
OIDC_ACADEMY_REDIRECT_URI=
OIDC_COMMAND_CLIENT_ID=
OIDC_COMMAND_CLIENT_SECRET=
OIDC_COMMAND_REDIRECT_URI=
SESSION_ENCRYPTION_KEY_HEX=
AUTH_DATABASE_URL=
ACADEMY_PUBLIC_ORIGIN=
COMMAND_PUBLIC_ORIGIN=
ACADEMY_RETURN_URL=
COMMAND_RETURN_URL=

# ---- runtime ----
SIE_INLINE_WORKER=0                    # 1 runs the worker inside the API process (single-process deployments)
SIE_WORKER_CONCURRENCY=64              # concurrent agent nodes per worker process
SIE_TENANT_CONCURRENCY=0               # max running nodes per tenant (0 = unlimited)
SIE_SANDBOX=auto                       # auto | bwrap | docker | disabled
SIE_EGRESS_ALLOWLIST=                  # hosts agents may fetch without approval, e.g. en.wikipedia.org,*.gov
SIE_METRICS_TOKEN=                     # protects /metrics when set
SIE_ERROR_WEBHOOK_URL=                 # receives JSON error reports
SIE_ENABLE_TEST_PROVIDER=0             # deterministic simulator (labels all output SIMULATED)
SIE_RATE_LIMIT_PER_MINUTE=1200         # authenticated requests per identity per API process
SIE_TRUST_PROXY=0                      # 1 when behind a reverse proxy that sets X-Forwarded-For
LOG_LEVEL=info
